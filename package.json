{
  "name": "erik-freitas-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "type-check": "vue-tsc --noEmit",
    "build": "npm run type-check && vite build && vite build --ssr src/entry-server.ts --outDir .build-ssr && node scripts/finalize.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node --test scripts/check.test.mjs"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/gloock": "^5.3.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vue-tsc": "^3.3.12"
  }
}
